[Desktop Entry]
Name=System Monitor
Comment=Monitor CPU, memory, disk and network activity
Exec=singularity-monitor
Icon=dev.sinty.monitor
Type=Application
Categories=System;Monitor;
X-Sinty-FormFactors=desktop;tablet;phone
Keywords=process;task;cpu;memory;kill;
StartupNotify=true
StartupWMClass=dev.sinty.monitor
